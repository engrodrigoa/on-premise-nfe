# =====================================================================
# on-premise-nfe: copie para .env e troque as senhas (make env faz isso)
# Os valores aqui são a visão do HOST. Dentro do compose os endereços são
# outros (DB_HOST=postgres, S3_ENDPOINT=http://minio:9000) e já estão no
# docker-compose.yml.
# =====================================================================

# --- Postgres (dados do projeto + banco "airflow" separado para os metadados)
DB_USER=nfe
DB_PASSWORD=change-me-db
DB_DB=nfe
DB_HOST=localhost
DB_PORT=5432

# --- role somente leitura do Grafana (criada por infra/postgres/init/00_bootstrap.sh)
GRAFANA_DB_PASSWORD=change-me-grafana-ro

# --- Airflow
# Linux/WSL: `id -u` (make env preenche)
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow
AIRFLOW_ADMIN_EMAIL=admin@example.org
# Compartilhados por TODOS os containers do Airflow. Sem um valor comum cada um gera o seu:
#   API__SECRET_KEY      assina os logs servidos   -> a UI devolve 403 ao abrir um log
#   API_AUTH__JWT_SECRET assina o token das tasks  -> toda task falha ao chamar a Execution API
#   CORE__FERNET_KEY     criptografa Connections e Variables (não troque depois de criado)
AIRFLOW__API__SECRET_KEY=change-me-airflow-secret
AIRFLOW__API_AUTH__JWT_SECRET=change-me-airflow-jwt
AIRFLOW__CORE__FERNET_KEY=

# --- object store (Silo, API S3): a custódia do XML bruto
# portas do object store no host (D015). O Windows pode reservar a 9001: se o `make up` falhar nela, use 9002
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=nfeadmin
MINIO_ROOT_PASSWORD=change-me-s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nfeadmin
S3_SECRET_KEY=change-me-s3

# --- custódia (decisão D003)
NFE_BUCKET_RAW=nfe-raw
# GOVERNANCE: a retenção pode ser removida por quem tem permissão explícita (adequado ao laboratório).
# COMPLIANCE: ninguém remove antes do prazo, nem o administrador. Só troque sabendo disso.
CUSTODIA_LOCK_MODE=GOVERNANCE
# 2190 dias = 6 anos (5 anos de decadência contados do exercício seguinte). A validar com o fiscal.
CUSTODIA_RETENCAO_DIAS=2190

# --- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
