    {
      "id": 7,
      "type": "timeseries",
      "title": "Quarentena e avisos por lote",
      "description": "Um ponto por lote, na data em que chegou. Pico isolado = lote ruim na origem; degrau = mudança no ERP ou na regra.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH atual AS (\n  SELECT DISTINCT ON (lote_id, regra) lote_id, regra, severidade, qtd_avaliados, qtd_falhas\n    FROM ctrl.dq\n   ORDER BY lote_id, regra, executado_em DESC, dq_id DESC\n)\nSELECT l.recebido_em AS time,\n       sum(a.qtd_falhas) FILTER (WHERE a.severidade = 'erro')  AS quarentena,\n       sum(a.qtd_falhas) FILTER (WHERE a.severidade = 'aviso') AS avisos\n  FROM atual a JOIN ctrl.lote l USING (lote_id)\n WHERE $__timeFilter(l.recebido_em)\n GROUP BY l.lote_id, l.recebido_em\n ORDER BY 1"
        }
      ],
