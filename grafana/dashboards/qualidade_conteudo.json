      "title": "Quarentena por motivo",
      "description": "Onde está o problema de origem. Uma linha por motivo com arquivos em quarentena no período. O detalhe arquivo a arquivo fica em silver.quarentena (fora do alcance do painel, por ter dado pessoal).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH atual AS (\n  SELECT DISTINCT ON (lote_id, regra) lote_id, regra, severidade, qtd_avaliados, qtd_falhas\n    FROM ctrl.dq\n   ORDER BY lote_id, regra, executado_em DESC, dq_id DESC\n)\nSELECT a.regra AS motivo, sum(a.qtd_falhas) AS arquivos,\n       count(*) FILTER (WHERE a.qtd_falhas > 0) AS lotes, max(l.recebido_em) AS ultimo\n  FROM atual a JOIN ctrl.lote l USING (lote_id)\n WHERE a.severidade = 'erro' AND a.qtd_falhas > 0 AND $__timeFilter(l.recebido_em)\n GROUP BY a.regra\n ORDER BY 2 DESC"
        }
      ],
