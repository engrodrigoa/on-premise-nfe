    {
      "id": 4,
      "type": "stat",
      "title": "Silver em dia?",
      "description": "A silver cobre tudo o que chegou? SIM quando nenhum lote tem falha da silver, nenhum lote carregado está há mais de 30 min fora dela e todo lote fecha bronze = válidos + quarentena + reenvios (D019, D020). Não depende do período. Quem age: Engenharia.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 'SIM' ELSE 'NÃO (' || count(*) || ' lote(s))' END AS em_dia\n  FROM ctrl.v_lote\n WHERE erro_transformacao IS NOT NULL\n    OR (status IN ('CARREGADO', 'INCOMPLETO') AND transformado_em IS NULL\n        AND carregado_em < now() - interval '30 minutes')\n    OR (transformado_em IS NOT NULL AND NOT silver_fechada)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "SIM": {
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^NÃO.*",
                "result": {
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^em_dia$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
