    {
      "id": 6,
      "type": "table",
      "title": "Avisos fiscais por regra",
      "description": "O que o fiscal precisa revisar, por regra. % = notas com o aviso sobre as notas válidas dos lotes do período.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
