            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH atual AS (\n  SELECT DISTINCT ON (lote_id, regra) lote_id, regra, severidade, qtd_avaliados, qtd_falhas\n    FROM ctrl.dq\n   ORDER BY lote_id, regra, executado_em DESC, dq_id DESC\n)\nSELECT a.regra, sum(a.qtd_falhas) AS notas,\n       round(100.0 * sum(a.qtd_falhas) / nullif(sum(a.qtd_avaliados), 0), 2) AS pct,\n       count(*) FILTER (WHERE a.qtd_falhas > 0) AS lotes\n  FROM atual a JOIN ctrl.lote l USING (lote_id)\n WHERE a.severidade = 'aviso' AND $__timeFilter(l.recebido_em)\n GROUP BY a.regra\nHAVING sum(a.qtd_falhas) > 0\n ORDER BY 2 DESC"
        }
