    {
      "id": 3,
      "type": "stat",
      "title": "Avisos por 100 notas",
      "description": "Densidade dos avisos: quantos avisos a cada 100 notas válidas do período. Sobe de repente = mudança no ERP ou na regra fiscal. Laranja a partir de 5.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH atual AS (\n  SELECT DISTINCT ON (lote_id, regra) lote_id, regra, severidade, qtd_avaliados, qtd_falhas\n    FROM ctrl.dq\n   ORDER BY lote_id, regra, executado_em DESC, dq_id DESC\n)\nSELECT round(100.0 * sum(a.qtd_falhas) / nullif(sum(a.qtd_avaliados) FILTER (WHERE a.regra = 'tot_cbs_divergente'), 0), 1) AS por_100\n  FROM atual a JOIN ctrl.lote l USING (lote_id)\n WHERE a.severidade = 'aviso' AND $__timeFilter(l.recebido_em)"
        }
      ],
      "fieldConfig": {
