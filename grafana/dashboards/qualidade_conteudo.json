    {
      "id": 1,
      "type": "stat",
      "title": "Arquivos em quarentena",
      "description": "Arquivos que não são um documento íntegro do grupo (D007): XML corrompido, emitente estranho, chave com dois conteúdos, evento sem nota. Conta a situação atual de cada lote do período (o evento que ganhou a nota sai da conta). Não é falha do pipeline. Quem age: TI do ERP (reenvio) ou Fiscal.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH atual AS (\n  SELECT DISTINCT ON (lote_id, regra) lote_id, regra, severidade, qtd_avaliados, qtd_falhas\n    FROM ctrl.dq\n   ORDER BY lote_id, regra, executado_em DESC, dq_id DESC\n)\nSELECT coalesce(sum(a.qtd_falhas), 0) AS arquivos\n  FROM atual a JOIN ctrl.lote l USING (lote_id)\n WHERE a.severidade = 'erro' AND $__timeFilter(l.recebido_em)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "sem dados",
