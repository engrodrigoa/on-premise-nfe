    {
      "id": 4,
      "type": "stat",
      "title": "Arquivos perdidos no pipeline",
      "description": "Perdemos algo entre a pasta e a bronze? Para cada lote terminado: arquivos contados na pasta x recebimentos registrados na custódia x linhas na bronze. Tem de ser 0 sempre; qualquer outro valor é incidente.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(sum(abs(coalesce(l.qtd_arquivos, 0) - coalesce(r.qtd, 0))\n                  + abs(coalesce(r.qtd, 0) - coalesce(l.qtd_bronze, 0))), 0) AS perdidos\n  FROM ctrl.lote l\n  LEFT JOIN (SELECT lote_id, count(*) AS qtd FROM custodia.recebimento GROUP BY lote_id) r USING (lote_id)\n WHERE l.status IN ('CARREGADO', 'INCOMPLETO', 'PROCESSADO')"
        }
      ],
      "fieldConfig": {
        "defaults": {
