    {
      "id": 11,
      "type": "stat",
      "title": "Lotes sem intervenção",
      "description": "Dos lotes que terminaram no período (inclusive em ERRO), quantos fecharam sem ninguém precisar agir: CARREGADO, sem hash divergente e sem arquivo fora do romaneio. Substitui a taxa de sucesso do Airflow, que conta como sucesso as execuções em que o sensor não achou lote.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE status IN ('CARREGADO', 'PROCESSADO')\n                                        AND coalesce(qtd_hash_divergente, 0) = 0\n                                        AND coalesce(qtd_nao_declarados, 0) = 0)\n             / nullif(count(*), 0), 1) AS pct\n  FROM ctrl.lote\n WHERE $__timeFilter(recebido_em) AND status IN ('CARREGADO', 'INCOMPLETO', 'PROCESSADO', 'ERRO')"
        }
      ],
      "fieldConfig": {
