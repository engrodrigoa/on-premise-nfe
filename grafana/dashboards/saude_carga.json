    {
      "id": 7,
      "type": "table",
      "title": "Divergências arquivo a arquivo",
      "description": "Conferência de cada lote contra o romaneio da origem (controle_lote.json). FALTANTE: declarado e não entregue. NAO_DECLARADO: entregue fora do romaneio. HASH_DIVERGENTE: chegou diferente do que saiu do ERP (o arquivo fica custodiado como evidência).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT l.nome_lote AS lote, d.arquivo, d.tipo,\n       left(d.sha256_declarado, 12) AS sha_declarado, left(d.sha256_recebido, 12) AS sha_recebido,\n       d.registrado_em AS registrado\n  FROM ctrl.lote_divergencia d\n  JOIN ctrl.lote l USING (lote_id)\n WHERE $__timeFilter(d.registrado_em)\n ORDER BY d.registrado_em DESC, d.arquivo\n LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
