    {
      "id": 5,
      "type": "stat",
      "title": "Custódia íntegra?",
      "description": "O XML legal continua igual ao que foi recebido? Resultado da verificação periódica de integridade (recalcula o sha256 de cada objeto). A DAG de verificação entra no marco 7: até lá, NUNCA VERIFICADA.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH u AS (\n  SELECT max(verificado_em) AS ultima,\n         count(*) FILTER (WHERE resultado <> 'OK' AND verificado_em > now() - interval '8 days') AS problemas\n    FROM ctrl.integridade_custodia\n)\nSELECT CASE WHEN problemas > 0                        THEN 'DIVERGENTE (' || problemas || ')'\n            WHEN ultima IS NULL                       THEN 'NUNCA VERIFICADA'\n            WHEN ultima < now() - interval '8 days'   THEN 'ATRASADA'\n            ELSE 'OK' END AS estado\n  FROM u"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "OK": {
                  "color": "green",
                  "index": 0
                },
                "NUNCA VERIFICADA": {
                  "color": "orange",
                  "index": 1
                },
                "ATRASADA": {
                  "color": "orange",
                  "index": 2
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^DIVERGENTE.*",
                "result": {
                  "color": "red",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^estado$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "O que exige ação",
      "description": "Uma linha por problema, com quem age. Vazia = nada a fazer. Falhas de processo aparecem sempre; os demais itens, dentro do período selecionado.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT severidade, quem_age, onde, o_que_aconteceu, desde FROM (\n  SELECT 'CRÍTICO' AS severidade, 'Engenharia' AS quem_age, nome_lote AS onde,\n         'falhou: ' || coalesce(mensagem, 'sem mensagem') AS o_que_aconteceu, recebido_em AS desde\n    FROM ctrl.lote WHERE status = 'ERRO'\n  UNION ALL\n  SELECT 'CRÍTICO', 'Engenharia', nome_lote,\n         'parado em ' || status || ' há ' || (extract(epoch FROM now() - recebido_em) / 60)::int || ' min',\n         recebido_em\n    FROM ctrl.lote WHERE status IN ('RECEBIDO', 'CUSTODIADO') AND recebido_em < now() - interval '30 minutes'\n  UNION ALL\n  SELECT 'ATENÇÃO', 'TI do ERP', nome_lote, mensagem, recebido_em\n    FROM ctrl.lote\n   WHERE $__timeFilter(recebido_em) AND (status = 'INCOMPLETO' OR coalesce(qtd_hash_divergente, 0) > 0)\n  UNION ALL\n  SELECT 'ATENÇÃO', 'Fiscal', 'chave ' || chave_acesso,\n         qtd_conteudos || ' XMLs diferentes custodiados para a mesma chave: qual é o válido?', primeiro_em\n    FROM custodia.v_chave_com_conteudos_diferentes WHERE $__timeFilter(ultimo_em)\n) a\nORDER BY severidade = 'CRÍTICO' DESC, desde DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "noValue": "nada a fazer",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
