            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS falhas\n  FROM ctrl.lote\n WHERE status = 'ERRO'\n    OR (status IN ('RECEBIDO', 'CUSTODIADO') AND recebido_em < now() - interval '30 minutes')\n    OR erro_transformacao IS NOT NULL\n    OR (status IN ('CARREGADO', 'INCOMPLETO') AND transformado_em IS NULL\n        AND carregado_em < now() - interval '30 minutes')"
        }
