    {
      "id": 6,
      "type": "table",
      "title": "O que exige ação",
      "description": "Uma linha por problema, com quem age. Vazia = nada a fazer. Falhas de processo aparecem sempre; os demais itens, dentro do período selecionado.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT severidade, quem_age, onde, o_que_aconteceu, desde FROM (\n  SELECT 'CRÍTICO' AS severidade, 'Engenharia' AS quem_age, nome_lote AS onde,\n         'falhou: ' || coalesce(mensagem, 'sem mensagem') AS o_que_aconteceu, recebido_em AS desde\n    FROM ctrl.lote WHERE status = 'ERRO'\n  UNION ALL\n  SELECT 'CRÍTICO', 'Engenharia', nome_lote,\n         'parado em ' || status || ' há ' || (extract(epoch FROM now() - recebido_em) / 60)::int || ' min',\n         recebido_em\n    FROM ctrl.lote WHERE status IN ('RECEBIDO', 'CUSTODIADO') AND recebido_em < now() - interval '30 minutes'\n  UNION ALL\n  SELECT 'CRÍTICO', 'Engenharia', nome_lote, 'silver falhou: ' || erro_transformacao, carregado_em\n    FROM ctrl.lote WHERE erro_transformacao IS NOT NULL\n  UNION ALL\n  SELECT 'CRÍTICO', 'Engenharia', nome_lote,\n         'carregado há ' || (extract(epoch FROM now() - carregado_em) / 60)::int || ' min e fora da silver',\n         carregado_em\n    FROM ctrl.lote\n   WHERE status IN ('CARREGADO', 'INCOMPLETO') AND transformado_em IS NULL AND erro_transformacao IS NULL\n     AND carregado_em < now() - interval '30 minutes'\n  UNION ALL\n  SELECT 'ATENÇÃO', 'TI do ERP', nome_lote, mensagem, recebido_em\n    FROM ctrl.lote\n   WHERE $__timeFilter(recebido_em) AND (status = 'INCOMPLETO' OR coalesce(qtd_hash_divergente, 0) > 0)\n  UNION ALL\n  SELECT 'ATENÇÃO', 'Fiscal', 'chave ' || chave_acesso,\n         qtd_conteudos || ' XMLs diferentes custodiados para a mesma chave: vale o 1º recebido (D022), o outro está na quarentena', primeiro_em\n    FROM custodia.v_chave_com_conteudos_diferentes WHERE $__timeFilter(ultimo_em)\n) a\nORDER BY severidade = 'CRÍTICO' DESC, desde DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "noValue": "nada a fazer",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severidade"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
