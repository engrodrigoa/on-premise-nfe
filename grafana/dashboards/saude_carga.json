    {
      "id": 12,
      "type": "stat",
      "title": "Volume do último lote",
      "description": "Volume fora do padrão? Arquivos que a origem declarou no último lote, comparados com a média do mesmo dia da semana nas 4 semanas anteriores (sábado e domingo têm menos nota). Fora de ±50%: perguntar à origem, mesmo com o romaneio fechado. Com menos de 2 semanas de histórico, não há base de comparação.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH l AS (\n  SELECT coalesce(declarado_arquivos, qtd_arquivos) AS qtd, to_date(substr(nome_lote, 6, 10), 'YYYY-MM-DD') AS dia\n    FROM ctrl.lote\n   WHERE status IN ('CARREGADO', 'INCOMPLETO', 'PROCESSADO') AND nome_lote ~ '^lote_[0-9]{4}-[0-9]{2}-[0-9]{2}$'\n), ultimo AS (SELECT qtd, dia FROM l ORDER BY dia DESC LIMIT 1),\nbase AS (    -- o mesmo dia da semana nas 4 semanas anteriores\n  SELECT avg(l.qtd) AS media, count(*) AS n\n    FROM l, ultimo\n   WHERE l.dia IN (ultimo.dia - 7, ultimo.dia - 14, ultimo.dia - 21, ultimo.dia - 28)\n)\nSELECT CASE WHEN base.n >= 2 THEN round(100.0 * (ultimo.qtd / base.media - 1)) END AS desvio\n  FROM ultimo, base"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "histórico curto",
          "color": {
            "mode": "thresholds"
          },
