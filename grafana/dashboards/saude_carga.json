    {
      "id": 1,
      "type": "stat",
      "title": "Horas sem carga",
      "description": "Está rodando? Horas desde o fim da última carga de lote. A origem entrega um lote por dia útil: acima de 26 h ou o ERP não entregou ou a DAG parou; acima de 74 h nem o fim de semana explica.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nfe"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round((extract(epoch FROM now() - max(carregado_em)) / 3600)::numeric, 1) AS horas\n  FROM ctrl.lote\n WHERE status IN ('CARREGADO', 'INCOMPLETO', 'PROCESSADO')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "noValue": "nunca carregou",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
