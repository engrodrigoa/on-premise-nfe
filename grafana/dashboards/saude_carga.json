            "type": "grafana-postgresql-datasource",
            "uid": "nfe"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT l.nome_lote AS lote, d.arquivo, d.tipo,\n       coalesce(left(d.sha256_declarado, 12), '—') AS sha_declarado,\n       coalesce(left(d.sha256_recebido, 12), '—') AS sha_recebido,\n       d.registrado_em AS registrado\n  FROM ctrl.lote_divergencia d\n  JOIN ctrl.lote l USING (lote_id)\n WHERE $__timeFilter(d.registrado_em)\n ORDER BY d.registrado_em DESC, d.arquivo\n LIMIT 200"
        }
